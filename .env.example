# דוגמה בלבד — כל הערכים פיקטיביים, להחליף בנתונים אמיתיים לפני שימוש
# להעתיק ל-.env.local ולמלא ערכים אמיתיים (לא לשמור סודות בקובץ הזה)

RABANIM_SUPABASE_URL=https://xxxxxxxxxxxxxxx.supabase.co
RABANIM_SUPABASE_SERVICE_KEY=example-service-role-key-000000000000
RABANIM_SUPABASE_DB_URL=postgresql://postgres:example-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

GREEN_API_INSTANCE=1100000000
GREEN_API_TOKEN=example00000000000000000000000000000000000000000000000000
GREEN_API_URL=https://api.green-api.com
GREEN_API_WEBHOOK_TOKEN=example-webhook-token-0000

PAYPAL_CLIENT_ID=example-paypal-client-id
PAYPAL_CLIENT_SECRET=example-paypal-client-secret

GREEN_INVOICE_API_KEY=example-invoice-api-key
GREEN_INVOICE_API_SECRET=example-invoice-api-secret

OWNER_NOTIFY_PHONE=972500000000

COURSE_SESSION_SECRET=example-random-session-secret
CRON_SECRET=example-random-cron-secret
MORNING_WEBHOOK_SECRET=example-random-morning-secret
MASHOV_ADMIN_KEY=example-random-mashov-admin-key

# Call recordings → Fireflies transcription pipeline
FIREFLIES_API_KEY=example-fireflies-api-key
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"example",...}
DRIVE_CALLS_FOLDER_ID=example-drive-folder-id
CALLS_CRON_SECRET=example-random-calls-cron-secret
# Same value as BLOB_READ_WRITE_TOKEN (public store) — passed explicitly
# because Vercel's auto-connected store shadows the ambient env var
CALLS_BLOB_TOKEN=example-vercel-blob-public-token
